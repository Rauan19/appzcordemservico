generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(TECHNICIAN)
  active    Boolean  @default(true)

  serviceOrdersAssigned ServiceOrder[] @relation("serviceOrderAssignedTo")
  serviceOrderAssignments ServiceOrderTechnician[]
  evaluationsAsTechnician ServiceOrderEvaluation[] @relation("EvaluationTechnician")
  evaluationsCreated      ServiceOrderEvaluation[] @relation("EvaluationCreatedBy")
  customerRatingsRecorded ServiceOrderCustomerRating[] @relation("CustomerRatingTechnician")
  devicePushTokens      DevicePushToken[]
  stockMovements        StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
  STOCK
  TECHNICIAN
}

model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Customer {
  id        String    @id @default(cuid())
  fullName  String
  cpf       String    @unique
  phone     String
  email     String?

  addresses Address[]
  serviceOrders ServiceOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label       String?  // "Casa", "Empresa", etc.
  street      String?
  number      String?
  district    String?
  city        String?
  state       String?
  zipCode     String?
  complement  String?
  reference   String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)

  serviceOrders ServiceOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model ServiceCatalog {
  id          String  @id @default(cuid())
  name        String
  description String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceOrder {
  id          String          @id @default(cuid())
  code        String          @unique
  status      ServiceOrderStatus @default(OPEN)
  priority    ServiceOrderPriority @default(NORMAL)

  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)

  addressId   String?
  address     Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?          @relation("serviceOrderAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  title       String
  description String?
  technicianReport String?
  customerPppoePassword String?
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?

  items       ServiceOrderItem[]
  stockMovements StockMovement[]
  assignees   ServiceOrderTechnician[]
  evaluation  ServiceOrderEvaluation?
  customerRating ServiceOrderCustomerRating?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
}

model ServiceOrderEvaluation {
  id             String       @id @default(cuid())
  serviceOrderId String       @unique
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  technicianId   String?
  technician     User?        @relation("EvaluationTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  rating         Int
  comment        String?

  createdById    String?
  createdBy      User?        @relation("EvaluationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianId])
  @@index([rating])
  @@index([createdAt])
}

model ServiceOrderCustomerRating {
  id             String       @id @default(cuid())
  serviceOrderId String       @unique
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  technicianId   String
  technician     User         @relation("CustomerRatingTechnician", fields: [technicianId], references: [id], onDelete: Restrict)

  rating         Int
  comment        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianId])
  @@index([rating])
  @@index([createdAt])
}

model ServiceOrderTechnician {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([serviceOrderId, userId])
  @@index([serviceOrderId])
  @@index([userId])
}

enum ServiceOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  DONE
  CANCELED
}

enum ServiceOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Product {
  id          String  @id @default(cuid())
  sku         String? @unique
  name        String
  series      String?
  unit        String  @default("un")
  active      Boolean @default(true)

  items         ServiceOrderItem[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([series])
}

model ServiceOrderItem {
  id            String  @id @default(cuid())
  serviceOrderId String
  serviceOrder  ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  description   String?
  quantity      Decimal? @db.Decimal(12, 3)
  unitPrice     Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceOrderId])
  @@index([productId])
}

model StockMovement {
  id            String @id @default(cuid())
  type          StockMovementType

  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  serviceOrderId String?
  serviceOrder  ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  userId        String?
  user          User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  quantity      Decimal @db.Decimal(12, 3)
  reason        String?
  note          String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([serviceOrderId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

enum StockMovementType {
  IN
  OUT_SERVICE_ORDER
  ADJUSTMENT
  RETURN
  DEFECT
}

