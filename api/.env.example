NODE_ENV=development
PORT=3333

# Docker Compose (API rodando no host, DB no container)
DATABASE_URL="postgresql://zc:zcpass@localhost:5439/zcnetconfig?schema=public"

JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="365d"

# CORS — URLs do painel web que podem chamar a API (separadas por vírgula)
# Use *.zcnetprovedor.com.br para liberar qualquer subdomínio HTTPS
CORS_ORIGINS=http://localhost:5555,http://127.0.0.1:5555,*.zcnetprovedor.com.br

# Push FCM  só a API precisa disso (para ENVIAR o push quando admin cria OS).
# Baixe em Firebase Console > Configurações > Contas de serviço > Gerar nova chave privada
# Salve o JSON em api/firebase-service-account.json e aponte aqui:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
